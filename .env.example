# --- Core ---
API_PORT=4201
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
# Swagger UI at /api/docs — set to 'false' to disable (e.g. in production)
SWAGGER_ENABLED=true

# --- Database ---
DATABASE_URL=postgres://blog:blog@localhost:5433/personal_blog
# 'true' in production (RDS with CA bundle baked into the image)
DATABASE_SSL=false

# --- Auth (A2) ---
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- S3 / assets (A4) ---
# Dev writes to the real bucket under its own prefix, so what you see locally is
# what production serves. Credentials are deliberately absent: the SDK falls back
# to ~/.aws/credentials, which keeps a live key out of this file. Set the pair
# explicitly only where there is no ambient credential (CI, containers).
S3_REGION=eu-central-1
S3_BUCKET=bahdashych-on-security
S3_KEY_PREFIX=dev
S3_PUBLIC_URL=https://bahdashych-on-security.s3.eu-central-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Offline alternative — the S3Mock service in docker-compose.dev.yml (any key
# pair works). Swap the lines above for these when you want no AWS dependency;
# the e2e suite needs them (it reads uploads back anonymously).
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=personal-blog-dev
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_PUBLIC_URL=http://localhost:9000/personal-blog-dev

# --- Frontend revalidation (A3) ---
FRONT_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=change-me

# --- Seed (dev only) ---
SEED_ADMIN_EMAIL=admin@localhost.dev
SEED_ADMIN_PASSWORD=
